{{> head}}
{{> navbar}}
<main class="main page page--tags">
   <div class="hero">
      <span class="hero__suptitle">
         {{tagsNumber}}
         {{ translate "tags.tags" (math tagsNumber '+' 0)}}
      </span>
      <h1>
         {{ translate 'tags.tagsPageTitle' }}
      </h1>
      <p class="hero__meta wrapper">
         {{ translate 'tags.description' }}
      </p>
   </div>

   <ul class="page--tags__listing">
      {{#each tags}}
         <li>
            <h2 class="h1">
               <a href="{{url}}" class="inverse">
                  {{name}}
               </a>
               <sup>({{postsNumber}})</sup>
            </h2>
            {{#checkIfAll description}}
               {{{description}}}
            {{/checkIfAll}}
         </li>
      {{/each}}
   </ul>
</main>
{{> footer}}
