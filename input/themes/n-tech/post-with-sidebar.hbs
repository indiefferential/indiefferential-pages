{{> head}}
{{> navbar}}
{{#if @config.custom.postSidebar}}   
   <main class="post">
      {{#post}}
         <div class="wrapper">
            <div class="container container--sidebar">
               <div class="content is-sidebar">
                  <article>
                     <header class="content__header">
                        <h1 class="content__title is-sidebar">{{title}}</h1>
                        {{#checkIfAny @config.post.displayMainTag @config.post.displayAuthor @config.post.displayDate @config.post.displayComments}}
                           <div class="card__meta content__meta">
                              {{#if @config.post.displayMainTag}}
                                 {{#if mainTag}}
                                    <a href="{{ mainTag.url }}">{{ mainTag.name }}</a>
                                 {{/if}}
                              {{/if}}
                              {{#if @config.post.displayAuthor}}
                                 <div class="content__author">{{ translate 'post.publishedBy' }}
                                    {{#author}}
                                       <a href="{{url}}" class="invert" rel="author">
                                          {{name}}</a>
                                    {{/author}}
                                 </div>
                              {{/if}}

                              {{#if @config.post.displayDate}}
                                 <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">
                                    {{#checkIf @config.custom.formatDate '!=' 'custom'}}
                                       {{date createdAt @config.custom.formatDate}}
                                    {{else}}
                                       {{date createdAt @config.custom.formatDateCustom}}
                                    {{/checkIf}}
                                 </time>
                              {{/if}}
                               
                              {{#if @config.post.displayComments}}
                                 <div class="card__comments">
                                     <a
                                       href="{{url}}#post-comments"
                                       class="invert"
                                       rel="nofollow" 
                                       aria-label="{{ translate 'post.comments' }}">                          
                                       <svg aria-hidden="true">
                                          <use xlink:href="{{@website.assetsUrl}}/svg/svg-map.svg#comments"/>
                                       </svg>
                                    </a>
                                 </div>
                              {{/if}}
                               
                           </div>
                        {{/checkIfAny}}
                     </header>

                     {{#featuredImage}}
                        {{#if url}}
                           <figure class="content__featured-image">
                              <img
                                 src="{{url}}"
                                 {{#if @config.site.responsiveImages}}                           
                                    {{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}
                                 {{/if}}
                                 {{ lazyload "eager" }}
                                 height="{{height}}"
                                 width="{{width}}"
                                 alt="{{alt}}">
                              {{#checkIfAny caption credits}}
                                 <figcaption>
                                    {{caption}}
                                    {{credits}}
                                 </figcaption>
                              {{/checkIfAny}}
                           </figure>
                        {{/if}}
                     {{/featuredImage}}
                      
                     {{#if @config.custom.postAd1}}
                         <div class="ads">
                             <div class="content__inner">
                                {{{@config.custom.postAd1}}}
                             </div>
                         </div>
                     {{/if}}

                     <div class="content__inner content__entry">
                        {{{text}}}
                     </div>

                     {{#checkIfAny @config.post.displayUpdatedDate @config.post.displayTags @config.post.displayShareButtons @config.post.displayAuthorBio @config.post.displayComments}}
                        <footer class="content__inner  content__footer">

                           {{#if @config.post.displayUpdatedDate}}
                              <div class="content__updated">{{ translate 'post.lastUpdatedDate' }}
                                 <time datetime="{{date modifiedAt 'YYYY-MM-DDTHH:mm'}}">
                                    {{#checkIf @config.custom.formatDate '!=' 'custom'}}
                                       {{date modifiedAt @config.custom.formatDate}}
                                    {{else}}
                                       {{date modifiedAt @config.custom.formatDateCustom}}
                                    {{/checkIf}}
                                 </time>
                              </div>
                           {{/if}}

                           {{#if @config.post.displayTags}}
                              <div class="content__tag">
                                 <h3 class="content__footer-title">{{ translate 'post.taggedIn' }}</h3>
                                 {{#if tags}}
                                    <ul class="content__tag-inner">
                                       {{#each tags}}
                                          <li>
                                             <a href="{{url}}" class="invert">
                                                {{name}}
                                             </a>
                                          </li>
                                       {{/each}}
                                    </ul>
                                 {{/if}}
                              </div>
                           {{/if}}

                           {{#if @config.post.displayShareButtons}}
                              {{#checkIfAll @plugins.socialSharing @plugins.socialSharing.state}}
                                 <div class="content__share">
                                    <h3 class="content__footer-title">{{ translate 'post.shareStory' }}</h3>
                                    <div class="content__share-inner">
                                       {{{@customSocialSharing}}}
                                    </div>
                                 </div>
                              {{else}}
                                 <div class="content__share">
                                    <h3 class="content__footer-title">{{ translate 'post.shareStory' }}</h3>
                                    <div class="content__share-inner">
                                       {{> share-buttons}}
                                    </div>
                                 </div>
                              {{/checkIfAll}}          
                           {{/if}}

                           {{#if @config.post.displayAuthorBio}}
                              <div class="author">
                                 {{#author}}
                                    {{#if avatar}}
                                     <img  src="{{avatarImage.url}}" 
                                       class="author__avatar" 
                                       {{ lazyload "lazy" }}
                                       alt="{{avatarImage.alt}}" 
                                       height="{{avatarImage.height}}" 
                                       width="{{avatarImage.width}}">                               
                                    {{/if}}
                                    <div class="author__info">
                                       <h3 class="h5  author__name">
                                          <a href="{{url}}" class="invert" rel="author">
                                             {{name}}
                                          </a>
                                       </h3>
                                       {{{description}}}
                                    </div>
                                 {{/author}}
                              </div>
                           {{/if}}

                           {{#if @config.post.displayComments}}
                              <div class="content__comments" id="post-comments">
                                 {{#checkIf @config.custom.commentOnClick '==' "click" }}
                                    <button class="content__comments-button js-content__comments-button">{{ translate 'post.loadComments' }}</button>
                                    <div
                                       class="content__comments-inner content__comments-inner--hidden js-content__comments-inner">
                                      {{{@commentsCustomCode}}}
                                    </div>
                                 {{else}}
                                    <div class="content__comments-inner">
                                       {{{@commentsCustomCode}}}
                                    </div>
                                 {{/checkIf}}
                              </div>
                           {{/if}}

                           {{#checkIfAny @config.post.displayPostNavigation @config.post.displayShareButtons}}
                              <div class="content__bar contentbar" id="js-content__bar">
                                 <div class="contentbar__inner {{#checkIfNone @config.post.displayPostNavigation}}contentbar__inner--center{{/checkIfNone}}">

                                    {{#if @config.post.displayPostNavigation}}
                                       <div class="contentbar__nav">
                                          <a
                                             class="contentbar__nav-link invert"
                                             href="{{#../previousPost}}{{url}}{{/../previousPost}}"
                                             rel="prev">
                                             <svg height="9" width="5">
                                                <use xlink:href="{{@website.assetsUrl}}/svg/svg-map.svg#arrow-prev"/>
                                             </svg>
                                             <span>
                                                {{ translate 'post.previousPost' }}
                                             </span>
                                          </a>
                                       </div>
                                    {{/if}}

                                    {{#if @config.post.displayShareButtons}}
                                       {{#checkIfAll @plugins.socialSharing @plugins.socialSharing.state}}
                                          <div class="contentbar__share">
                                             <div class="contentbar__share-inner">
                                                <h3>{{ translate 'post.share' }}</h3>
                                                {{{@customSocialSharing}}}
                                             </div>
                                          </div>
                                       {{else}}
                                          <div class="contentbar__share">
                                             <div class="contentbar__share-inner">
                                                <h3>{{ translate 'post.share' }}</h3>
                                                {{> share-buttons-contentbar}}
                                             </div>
                                          </div>
                                       {{/checkIfAll}}           
                                    {{/if}}

                                    {{#if @config.post.displayPostNavigation}}
                                       <div class="contentbar__nav">
                                          <a
                                             class="contentbar__nav-link invert"
                                             href="{{#../nextPost}}{{url}} {{/../nextPost}}"
                                             rel="prev">
                                             <span>
                                                {{ translate 'post.nextPost' }}
                                             </span>
                                             <svg height="9" width="5">
                                                <use xlink:href="{{@website.assetsUrl}}/svg/svg-map.svg#arrow-next"/>
                                             </svg>
                                          </a>
                                       </div>
                                    {{/if}}

                                    <div class="contentbar__progress" id="js-contentbar__progress" aria-hidden="true"></div>

                                 </div>
                              </div>
                           {{/checkIfAny}}

                        </footer>
                     {{/checkIfAny}}
                  </article>
                   
                  {{#if @config.custom.postAd2}}
                     <div class="ads ads--mt">
                         {{{@config.custom.postAd2}}}                       
                     </div>
                  {{/if}}
                   
               </div>
            {{/post}}            
            {{> sidebar}}            
         </div>
      </div>      
       
      {{#post}}
         {{#if @config.post.displayRelatedPosts}}
            {{#if ../relatedPosts}}
               <div class="content__related">
                  <div class="wrapper">
                     <h3 class="h6">
                        {{ translate 'post.relatedPosts' }}
                     </h3>
                     <div class="cards content__related-cards">
                        {{#each ../relatedPosts}}
                           <div class="card__item">
                              {{#if @config.custom.frontFeaturedImage}}
                                 {{#featuredImage}}
                                    {{#if url}}
                                       <a href="{{../url}}" class="card__image">
                                          <img
                                             src="{{urlMd}}"
                                             {{ lazyload "lazy" }}
                                             height="{{height}}"
                                             width="{{width}}"
                                             alt="{{alt}}">
                                       </a>                              
                                    {{/if}}
                                 {{/featuredImage}}
                              {{/if}}
                              <div class="card__content">
                                 <h3 class="card__title">
                                    <a href="{{url}}" class="invert">{{title}}</a>
                                 </h3>
                                 {{#checkIfAny @config.custom.frontAuthor @config.custom.frontDate}}
                                    <div class="card__meta">
                                       {{#if @config.custom.frontAuthor}}
                                          <div class="card__author">{{ translate 'post.publishedBy' }}
                                             {{#author}}
                                                <a href="{{url}}" class="invert" rel="author">
                                                   {{name}}</a>
                                             {{/author}}
                                          </div>
                                       {{/if}}
                                       {{#if @config.custom.frontDate}}
                                          <time datetime="{{date createdAt 'YYYY-MM-DDTHH:mm'}}">
                                             {{#checkIf @config.custom.formatDate '!=' 'custom'}}
                                                {{date createdAt @config.custom.formatDate}}
                                             {{else}}
                                                {{date createdAt @config.custom.formatDateCustom}}
                                             {{/checkIf}}
                                          </time>
                                       {{/if}}
                                    </div>
                                 {{/checkIfAny}}
                              </div>
                           </div>
                        {{/each}}
                     </div>
                  </div>
               </div>
            {{/if}}
         {{/if}}
      {{/post}}
   </main>

{{else}}
   {{> post-default}}
{{/if}}
{{> footer}}