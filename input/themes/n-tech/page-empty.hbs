{{> head}}
{{> navbar}}
{{#page}}
   <main class="page">
      <div class="wrapper">
         <div class="content">
            <div>
               <div class="content__header content__header--full">
                  <h1 class="content__title">{{title}}</h1>
               </div>

               {{#featuredImage}}
                  {{#if url}}
                     <figure class="content__hero-image content__hero-image--full">
                        <img
                           src="{{url}}"
                           {{#if @config.site.responsiveImages}}                           
                              {{responsiveImageAttributes 'featuredImage' srcset.post sizes.post}}
                           {{/if}}
                           {{ lazyload "eager" }}
                           height="{{height}}"
                           width="{{width}}"
                           alt="{{alt}}">
                        {{#checkIfAny caption credits}}
                           <figcaption>
                              {{caption}}
                              {{credits}}
                           </figcaption>
                        {{/checkIfAny}}
                     </figure>                     
                  {{/if}}
               {{/featuredImage}}

               <div class="content__entry">
                  {{{text}}}
               </div>

               {{#if @config.page.displayChildPages}}
                  {{#if subpages}}
                     <div class="subpages">
                        <h2 class="h5 subpages__title">{{ translate 'page.childPages' }}</h2>
                        <ul class="subpages__list">
                           {{> subpages-list}}
                        </ul>
                     </div>
                  {{/if}}
               {{/if}}
            </div>
         </div>
      </div>

   </main>
{{/page}}
{{> footer}}
